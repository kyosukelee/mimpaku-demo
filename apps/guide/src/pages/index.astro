---
import { slug } from "../i18n";
import { staticData } from "../lib/staticData";
const property = staticData.property;
const to = "/p/" + slug + "/";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={"0; url=" + to} />
    <meta name="robots" content="noindex" />
    <title>{property.name_ja}</title>
  </head>
  <body><p><a href={to}>{property.name_ja}</a></p></body>
</html>
