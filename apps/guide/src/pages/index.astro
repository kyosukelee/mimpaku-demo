---
import { property } from "../i18n";
const to = "/p/" + property.slug + "/";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={"0; url=" + to} />
    <meta name="robots" content="noindex" />
    <title>{property.name.ja}</title>
  </head>
  <body><p><a href={to}>{property.name.ja}</a></p></body>
</html>
