---
import Guide from "../../../../layouts/Guide.astro";
import { t, property, pageUrl, paths, PAGES } from "../../../../i18n";
import type { Lang, Page } from "../../../../i18n";
export const getStaticPaths = paths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Guide lang={lang} page="home">
  <section slot="hero" class="hero">
    <svg class="river" viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none" stroke="#7fc3e6" stroke-opacity="0.45" stroke-width="1.5" stroke-linecap="round">
      <path d="M-10 20 C 90 30, 140 90, 210 120 S 330 150, 420 140" />
      <path d="M-10 40 C 80 60, 130 110, 200 140 S 320 190, 420 200" />
      <path d="M210 120 C 250 150, 280 200, 300 270" />
      <path d="M200 140 C 220 180, 220 230, 250 270" />
      <path d="M-10 70 C 70 90, 120 140, 190 160 S 290 230, 330 270" />
    </svg>
    <div class="wrap">
      <h1>{property.name[lang]}</h1>
      <p>{property.tagline[lang]}</p>
      <dl class="times">
        <div class="time"><dt>{s.checkIn}</dt><dd>{property.checkIn}</dd></div>
        <div class="time"><dt>{s.checkOut}</dt><dd>{property.checkOut}</dd></div>
      </dl>
    </div>
  </section>
  <p class="lead" style="margin-top:24px">{s.homeLead}</p>
  <ul class="menu">
    {PAGES.filter((p: Page) => p !== "home").map((p: Page) => (
      <li><a href={pageUrl(lang, p)}>{s.menu[p]}</a></li>
    ))}
  </ul>
</Guide>
