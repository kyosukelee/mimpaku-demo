---
import { LANGS, slug } from "../../../i18n";
import { staticData } from "../../../lib/staticData";
const property = staticData.property;
export function getStaticPaths() {
  return [{ params: { slug } }];
}
const base = "/p/" + slug + "/";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{property.name_ja}</title>
    <script is:inline define:vars={{ base }}>
      var lang = "";
      try { lang = localStorage.getItem("lang") || ""; } catch (e) {}
      if (lang !== "ja" && lang !== "en") {
        var n = (navigator.language || "en").toLowerCase();
        lang = n.indexOf("ja") === 0 ? "ja" : "en";
      }
      location.replace(base + lang + "/");
    </script>
  </head>
  <body style="font-family:sans-serif;padding:24px;line-height:1.8">
    <p>{property.name_ja} / {property.name_en}</p>
    <ul>
      {LANGS.map((l) => <li><a href={base + l + "/"}>{l === "ja" ? "日本語" : "English"}</a></li>)}
    </ul>
  </body>
</html>
